# Copy this file to ".env" (same folder) and fill in your own values.
# The .env file must NEVER be committed to git.

# Get a free key at https://aistudio.google.com/apikey
# If you leave this blank the AI chat still works using built-in answers.
GEMINI_API_KEY=

# Any long random string. Change this before deploying anywhere public.
JWT_SECRET=change-this-to-a-long-random-string

PORT=4000
